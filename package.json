{
  "name": "common-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build:linux": "tauri build --bundles appimage,deb",
    "desktop:build:mac:arm64": "tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "desktop:build:mac:x64": "tauri build --target x86_64-apple-darwin --bundles app,dmg",
    "desktop:build:windows:x64": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "desktop:build:windows:arm64": "tauri build --target aarch64-pc-windows-msvc --bundles nsis",
    "desktop:build:mac:arm64:unsigned": "tauri build --target aarch64-apple-darwin --bundles app,dmg --config src-tauri/tauri.unsigned.conf.json",
    "desktop:build:mac:x64:unsigned": "tauri build --target x86_64-apple-darwin --bundles app,dmg --config src-tauri/tauri.unsigned.conf.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "element-plus": "^2.4.4",
    "jsqr": "^1.4.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^4.5.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.2.12"
  }
}
